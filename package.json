{
  "name": "jogae",
  "private": true,
  "description": "Monorepo do Jogaê: app mobile, servidor de salas, engine compartilhado e Supabase.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "mobile": "npm run start -w @jogae/mobile",
    "ios": "npm run ios -w @jogae/mobile",
    "android": "npm run android -w @jogae/mobile",
    "room-server": "npm run dev -w @jogae/room-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke:room": "npm run smoke:room -w @jogae/mobile",
    "check": "npm run typecheck && npm run test && npm run smoke:room",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff --schema public",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "db:stop": "supabase stop",
    "test:db": "tsx --tsconfig apps/mobile/tsconfig.json --test apps/mobile/test/*.integration.test.ts"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
