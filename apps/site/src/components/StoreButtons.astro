---
import { stores } from '../lib/config';

interface Props {
  /** `badge`: botões brancos com ícone (hero) · `plain`: branco + roxo, só texto (CTA final e convite) */
  variant?: 'badge' | 'plain';
  /** Texto longo nos botões `plain` ("Baixar na App Store") — usado no convite. */
  long?: boolean;
  /** Nome da página, para o evento de analytics. */
  page: string;
  center?: boolean;
}
const { variant = 'plain', long = false, page, center = false } = Astro.props;

const items = [
  { store: 'ios', url: stores.ios, name: 'App Store', prefix: 'Baixar na', soon: 'Em breve na', longLabel: 'Baixar na App Store' },
  { store: 'android', url: stores.android, name: 'Google Play', prefix: 'Disponível no', soon: 'Em breve no', longLabel: 'Baixar no Google Play' },
] as const;

// Pré-computado aqui (e não no template) porque o template do Astro não aceita anotações de tipo.
const buttons = items.map((item, index) => {
  const live = Boolean(item.url);
  const attrs: Record<string, string> = live
    ? { href: item.url, rel: 'noopener', 'data-store-link': item.store, 'data-page': page }
    : { 'aria-disabled': 'true' };
  return {
    ...item,
    live,
    attrs,
    // Link de verdade quando há URL da loja; senão um rótulo "Em breve" que não é clicável.
    Tag: (live ? 'a' : 'span') as 'a',
    label: live ? `Baixar o Jogaê ${item.store === 'ios' ? 'na App Store' : 'no Google Play'}` : `Jogaê ${item.soon.toLowerCase()} ${item.name}`,
    plainText: live ? (long ? item.longLabel : item.name) : `${item.soon} ${item.name}`,
    plainClass: index === 0 ? 'btn-white' : 'btn-primary',
  };
});
---

<div class:list={['stores', { center }]}>
  {
    buttons.map(({ Tag, attrs, label, live, ...item }) => {
      return variant === 'badge' ? (
        <Tag class="badge" aria-label={label} {...attrs}>
          {item.store === 'ios' ? (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="#0F0F13" aria-hidden="true">
              <path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.8-3.5.8-.7 0-1.9-.8-3.1-.8-1.6 0-3.1.9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.5.8 1.2 1.8 2.4 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.1.8 1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.7-1-2.7-4zM14.2 5.8c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L3.7 2.2z" fill="#22C55E" />
              <path d="m16.2 15.6-3.2-3.2v-.2l3.2-3.2.1.1 3.8 2.2c1.1.6 1.1 1.6 0 2.2z" fill="#FACC15" />
              <path d="m16.3 15.5-3.3-3.3-9.4 9.4c.4.4 1 .4 1.7 0z" fill="#EF4444" />
              <path d="M3.6 2.2c-.4.4-.4 1-.4 1.5l9.4 9.4 3.3-3.3z" fill="#7C3AED" />
            </svg>
          )}
          <span>
            <span class="badge-small">{live ? item.prefix : item.soon}</span>
            <span class="badge-name">{item.name}</span>
          </span>
        </Tag>
      ) : (
        <Tag class:list={['btn', item.plainClass]} aria-label={label} {...attrs}>
          {item.plainText}
        </Tag>
      );
    })
  }
</div>

<style>
  .stores {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .stores.center {
    justify-content: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--text);
    color: var(--bg);
    border-radius: 16px;
    padding: 12px 18px;
    transition: transform 0.12s ease;
  }
  .badge:hover {
    color: var(--bg);
  }
  a.badge:active {
    transform: scale(0.97);
  }
  .badge[aria-disabled='true'] {
    opacity: 0.8;
    cursor: default;
  }
  .badge-small {
    display: block;
    font: 400 10px/1.1 var(--body);
  }
  .badge-name {
    display: block;
    font: 700 20px/1 var(--display);
    text-transform: uppercase;
  }
</style>
