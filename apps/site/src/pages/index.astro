---
import PhoneHome from '../components/PhoneHome.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { faq, games, perks, premiumEnabled, steps } from '../data/content';
import Base from '../layouts/Base.astro';

const description = 'Jogos sociais para jogar com os amigos no mesmo lugar. O app sorteia papéis secretos, conduz as rodadas, abre a votação e revela quem era o impostor.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Jogaê',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS, Android',
  inLanguage: 'pt-BR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
};
---

<Base title="Jogaê — Todo mundo sabe a palavra. Menos um." description={description} path="/" jsonLd={jsonLd}>
  <div class="landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="badges">
          <span class="pill pill-outline overline">3–12 jogadores</span>
          <span class="pill pill-accent overline">Grátis para começar</span>
        </div>
        <h1 id="hero-title" class="h1">Todo mundo sabe a palavra.<br /><span class="accent">Menos um.</span></h1>
        <p class="lead hero-lead">Vocês já estão juntos. O Jogaê vira o mestre do jogo: sorteia papéis secretos, conduz as rodadas, abre a votação e revela quem era o impostor.</p>
        <StoreButtons variant="badge" page="home-hero" />
        <p class="note">Sem cadastro obrigatório — dá para entrar como convidado.</p>
      </div>
      <div class="hero-phone"><PhoneHome /></div>
    </section>

    <section id="como-funciona" aria-labelledby="como-title">
      <h2 id="como-title" class="h2 section-title">Em menos de 30 segundos</h2>
      <div class="grid-auto steps">
        {
          steps.map((s) => (
            <div class="card step">
              <div class="step-number" style={`background:${s.bg};color:${s.fg}`}>{s.k}</div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="jogos" aria-labelledby="jogos-title">
      <div class="section-head">
        <h2 id="jogos-title" class="h2">Os jogos</h2>
        <p class="muted">Novos jogos todo mês</p>
      </div>
      <div class="grid-auto games">
        {
          games.map((g) => (
            <article class="game" style={`background:${g.bg};color:${g.fg}`}>
              <div class="game-top">
                <span class="game-cat">{g.category}</span>
                <span class="game-emoji" aria-hidden="true">{g.emoji}</span>
              </div>
              <div>
                <h3 class="game-name">{g.name}</h3>
                <p class="game-text">{g.text}</p>
                <p class="game-meta">{g.meta}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {premiumEnabled && (
    <section id="premium" class="premium" aria-labelledby="premium-title">
      <div class="premium-copy">
        <p class="premium-over">✨ Premium</p>
        <h2 id="premium-title" class="premium-title">Um jogo feito para o seu grupo</h2>
        <p class="premium-text">Diga quantos vocês são e o clima da noite. A IA monta perguntas, desafios e rodadas especiais na hora.</p>
        <ul class="perks">
          {perks.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="plans">
        <div class="plan-row">
          <div class="plan">
            <p class="plan-label">Mensal</p>
            <p class="plan-price">R$ 14,90</p>
            <p class="plan-note">por mês</p>
          </div>
          <div class="plan plan-best">
            <p class="plan-label">Anual</p>
            <p class="plan-price">R$ 99</p>
            <p class="plan-note">R$ 8,25 / mês</p>
          </div>
        </div>
        <a class="btn btn-white plan-cta" href="#baixar" data-premium-cta>Começar 7 dias grátis</a>
        <p class="plan-foot">Cancele quando quiser. Só uma pessoa do grupo precisa assinar.</p>
      </div>
    </section>
    )}

    <section id="duvidas" aria-labelledby="faq-title">
      <h2 id="faq-title" class="h2 section-title">Perguntas rápidas</h2>
      <div class="faq">
        {
          faq.map((f, i) => (
            <details name="faq" open={i === 0} data-q={f.q}>
              <summary>
                <span>{f.q}</span>
                <span class="plus" aria-hidden="true">+</span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="baixar" class="final" aria-labelledby="final-title">
      <svg viewBox="0 0 40 40" width="72" height="72" aria-hidden="true">
        <ellipse cx="20" cy="20" rx="17" ry="11" fill="#FAFAFA"></ellipse>
        <g class="blink" style="transform-origin:20px 20px">
          <circle cx="23.5" cy="20" r="6.5" fill="#7C3AED"></circle>
          <circle cx="26" cy="17.5" r="2.2" fill="#FACC15"></circle>
        </g>
      </svg>
      <h2 id="final-title" class="final-title">Bora jogar?</h2>
      <StoreButtons page="home-final" center />
    </section>
  </div>
</Base>

<style>
  .landing {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    padding-bottom: 80px;
  }
  section {
    scroll-margin-top: 24px;
  }
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 40px;
    align-items: center;
    padding-top: 40px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .hero-lead {
    max-width: 520px;
  }
  .note {
    font: 400 13px var(--body);
    color: var(--muted-dark);
  }
  .hero-phone {
    display: flex;
    justify-content: center;
    min-width: 0;
    padding: 20px 0;
  }
  .section-title {
    margin-bottom: 28px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .section-head p {
    font: 400 15px var(--body);
  }
  .steps {
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .step p {
    font: 400 15px/1.5 var(--body);
    color: var(--muted);
    text-wrap: pretty;
  }
  .games {
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  .game {
    border-radius: 24px;
    padding: 22px;
    min-height: 210px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
  }
  .game-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .game-cat {
    font: 600 10px var(--body);
    letter-spacing: 0.7px;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .game-emoji {
    font-size: 24px;
  }
  .game-name {
    font: 800 28px/0.95 var(--display);
    text-transform: uppercase;
  }
  .game-text {
    font: 500 13px/1.4 var(--body);
    opacity: 0.9;
    margin-top: 8px;
  }
  .game-meta {
    font: 600 12px var(--body);
    opacity: 0.85;
    margin-top: 10px;
  }
  .premium {
    background: var(--primary);
    border-radius: 32px;
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 32px;
    align-items: center;
  }
  .premium-copy {
    min-width: 0;
  }
  .premium-over {
    font: 600 12px var(--body);
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .premium-title {
    font: 800 clamp(34px, 4.5vw, 56px) / 0.95 var(--display);
    text-transform: uppercase;
    margin-top: 12px;
    text-wrap: balance;
  }
  .premium-text {
    font: 500 16px/1.5 var(--body);
    color: rgba(250, 250, 250, 0.9);
    margin-top: 14px;
    max-width: 460px;
  }
  .perks {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .perks li {
    background: rgba(15, 15, 19, 0.3);
    border-radius: 99px;
    padding: 9px 13px;
    font: 600 13px var(--body);
  }
  .plans {
    background: rgba(15, 15, 19, 0.35);
    border-radius: 24px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .plan-row {
    display: flex;
    gap: 10px;
  }
  .plan {
    flex: 1;
    border-radius: 18px;
    background: rgba(15, 15, 19, 0.4);
    padding: 16px;
    min-width: 0;
  }
  .plan-best {
    background: var(--accent);
    color: var(--bg);
  }
  .plan-label {
    font: 600 11px var(--body);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .plan-price {
    font: 800 32px/1 var(--display);
    margin-top: 6px;
  }
  .plan-note {
    font: 500 12px var(--body);
    opacity: 0.85;
    margin-top: 4px;
  }
  .plan-cta {
    height: 54px;
    padding: 0 16px;
  }
  .plan-foot {
    font: 400 12px var(--body);
    color: rgba(250, 250, 250, 0.85);
    text-align: center;
  }
  .faq {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  details {
    background: var(--surface);
    border-radius: 20px;
    padding: 20px 22px;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    font: 700 19px var(--body);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span:first-child {
    flex: 1;
    min-width: 0;
  }
  .plus {
    font: 400 22px var(--body);
    color: var(--muted);
    transition: transform 0.2s;
  }
  details[open] .plus {
    transform: rotate(45deg);
  }
  details p {
    font: 400 15px/1.55 var(--body);
    color: var(--muted);
    max-width: 760px;
    text-wrap: pretty;
    margin-top: 10px;
  }
  .final {
    background: var(--surface);
    border-radius: 32px;
    padding: clamp(28px, 5vw, 56px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .final-title {
    font: 800 clamp(40px, 6vw, 72px) / 0.95 var(--display);
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .plus {
      transition: none;
    }
  }
</style>
