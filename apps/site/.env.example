# Todas opcionais: sem nenhuma o site funciona, com os botões de loja em "Em breve".

# Endereço público do site (canonical, og:url, sitemap). Padrão: o da Vercel, senão https://jogaeapp.com.br
SITE_URL=

# Servidor de salas: de onde vêm host, jogo e jogadores da página de convite.
ROOM_API_URL=https://jogae.fly.dev

# Links das lojas. Os de produção já estão no código (src/lib/config.ts); estas variáveis só
# existem para sobrescrever — link de campanha, loja de outro país, ambiente de teste.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=

# Deep links. Sem eles os arquivos .well-known saem válidos porém vazios (o link abre o navegador, não o app).
#   APPLE_TEAM_ID: developer.apple.com → Membership → Team ID (10 caracteres)
#   ANDROID_SHA256_FINGERPRINTS: Play Console → Integridade do app → certificado de assinatura (vários: separe por vírgula)
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=

# Analytics sem cookies (Plausible). Vazio = nenhum script de terceiros.
PUBLIC_PLAUSIBLE_DOMAIN=
