# Copie para .env.local (não versionado). Sem estas variáveis o app roda com serviços simulados.
# Local (`npm run db:start` na raiz imprime os valores):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321   ← no celular físico use o IP da máquina
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Servidor de salas (npm run room-server na raiz). Sem isto, as salas são simuladas com bots.
# No celular físico use o IP do Mac na rede Wi-Fi, ex.: ws://192.168.0.12:8787/ws
EXPO_PUBLIC_ROOM_SERVER_URL=

# Endereço do site (links de convite e páginas legais). Enquanto não há domínio, use o endereço provisório da Vercel.
EXPO_PUBLIC_SITE_URL=
