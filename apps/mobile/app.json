{
  "expo": {
    "name": "Jogaê",
    "slug": "jogae",
    "scheme": "jogae",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F13",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    },
    "ios": {
      "bundleIdentifier": "app.jogae",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:jogaeapp.com.br",
        "applinks:www.jogaeapp.com.br"
      ]
    },
    "android": {
      "package": "app.jogae",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jogaeapp.com.br",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "jogaeapp.com.br",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "www.jogaeapp.com.br",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "www.jogaeapp.com.br",
              "pathPrefix": "/u/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Jogaê usa a câmera para ler o QR Code da sala."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4825299331683087~9857069401",
          "iosAppId": "ca-app-pub-4825299331683087~4279465784",
          "userTrackingUsageDescription": "O Jogaê usa isso para mostrar anúncios mais relevantes. Você pode recusar — o app funciona igual, só com anúncios genéricos.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "expo-tracking-transparency"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74b95e30-1336-40d6-ad6e-93bf9f4e6705"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4825299331683087~9857069401",
    "ios_app_id": "ca-app-pub-4825299331683087~4279465784"
  }
}
