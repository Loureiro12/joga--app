{
  "name": "@jogae/room-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de salas em tempo real (WebSocket) do Jogaê.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "bots": "tsx src/dev/bots.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:bufferutil --external:utf-8-validate --sourcemap --log-level=warning",
    "start:prod": "node --enable-source-maps dist/server.cjs"
  },
  "dependencies": {
    "@jogae/engine": "*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "esbuild": "^0.28.2"
  }
}
