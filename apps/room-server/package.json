{
  "name": "@jogae/room-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de salas em tempo real (WebSocket). Esqueleto da fundação — o protocolo entra no passo 3 do plano.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
