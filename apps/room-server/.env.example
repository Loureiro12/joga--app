# Copie para .env (não versionado).
PORT=8787
NODE_ENV=development

# supabase      → só login real (produção exige este)
# dev           → só tokens "dev:<id>" (testes e bots); é o padrão quando SUPABASE_URL não está definido
# supabase+dev  → login real no celular + bots para encher a sala (recomendado em dev)
AUTH_MODE=supabase+dev

# Os mesmos valores de apps/mobile/.env.local (a chave é a PÚBLICA).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave SECRETA do projeto (Project Settings → API Keys → secret / service_role). NUNCA vai para o app
# nem para o git. Sem ela o servidor funciona, mas as partidas não entram no histórico.
SUPABASE_SERVICE_ROLE_KEY=

# Grava o estado das salas em disco para sobreviver a reinícios. Vazio = só memória.
ROOM_STORE_DIR=.data/rooms
